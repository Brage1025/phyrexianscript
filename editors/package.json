{
  "name": "phyx",
  "displayName": "φyrx",
  "description": "φyrx (PhyrxScript / PhyrexianScript) — a programming language written in Phyrexian",
  "version": "1.7.0",
  "publisher": "brage1025",
  "icon": "phyx-original.png",
  "license": "MIT",
  "homepage": "https://github.com/Brage1025/phyrexianscript",
  "bugs": {
    "url": "https://github.com/Brage1025/phyrexianscript/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Brage1025/phyrexianscript.git"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:phyx",
    "onCommand:phyx.installFonts",
    "onCommand:phyx.toggleFont"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Language features run phyx, so they are disabled until the workspace is trusted. Syntax highlighting and the font commands still work."
    }
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "phyx",
    "phyrx",
    "phyrxscript",
    "phyrexianscript",
    "phyrexian"
  ],
  "contributes": {
    "commands": [
      {
        "command": "phyx.installFonts",
        "title": "φyrx: Install fonts"
      },
      {
        "command": "phyx.toggleFont",
        "title": "φyrx: Toggle Phyrexian font"
      }
    ],
    "configuration": {
      "title": "φyrx",
      "properties": {
        "phyx.offerFontInstall": {
          "type": "boolean",
          "default": true,
          "description": "Offer to install the Phyrexian font the first time a φyrx file is opened."
        },
        "phyx.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to the Python interpreter or phyx executable used to start the φyrx language server. Leave empty to search PATH."
        }
      }
    },
    "languages": [
      {
        "id": "phyx",
        "aliases": [
          "φyrx",
          "PhyrxScript",
          "PhyrexianScript"
        ],
        "extensions": [
          ".phyx",
          ".vphyx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "phyx",
        "scopeName": "source.phyx",
        "path": "./phyx.tmLanguage.json"
      }
    ]
  }
}
